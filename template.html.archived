<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cerebrum Quest — Knowledge Adventure</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
  :root {
    --bg: #0a0f1a;
    --bg2: #111827;
    --fg: #e8ecf4;
    --muted: #6b7a99;
    --accent: #f59e0b;
    --accent2: #10b981;
    --accent3: #5b8def;
    --card: rgba(17, 24, 39, 0.88);
    --border: rgba(255,255,255,0.08);
    --shadow: 0 8px 32px rgba(0,0,0,0.3);
    --science: #06b6d4;
    --history: #f59e0b;
    --geography: #10b981;
    --math: #ef4444;
    --language: #a855f7;
    --nature: #22c55e;
    --culture: #ec4899;
    --danger: #ef4444;
  }
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  button,input,select,textarea,a,.btn,.nav-tab,.option-btn,.category-card,.level-card{touch-action:manipulation;-webkit-touch-callout:none;cursor:pointer;}
  body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--fg);min-height:100vh;overflow-x:hidden;-webkit-text-size-adjust:100%;}
  body.keyboard-open .welcome-container{min-height:auto;justify-content:flex-start;padding-top:20px;}
  body.keyboard-open .welcome-icon,body.keyboard-open .stats-bar{display:none;}
  body.keyboard-open .welcome-tagline{display:none;}
  h1, h2, h3, .results-title, .score-ring-value, .stat-value, .welcome-title, .hub-title { font-family: 'Syne', sans-serif; }
  
  ::-webkit-scrollbar { width: 8px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }

  #bgCanvas{position:fixed;top:0;left:0;width:100%;height:100%;z-index:0;pointer-events:none;}

  /* NAV */
  .main-nav{position:sticky;top:0;z-index:100;display:flex;justify-content:center;gap:24px;padding:0 16px;background:rgba(10,15,26,0.8);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);}
  .nav-tab{padding:16px 8px;background:transparent;border:none;border-bottom:2px solid transparent;color:var(--muted);font-family:inherit;font-size:14px;font-weight:600;cursor:pointer;transition:all .25s;display:flex;align-items:center;gap:8px;touch-action:manipulation;-webkit-tap-highlight-color:transparent;}
  .nav-tab:hover{color:var(--fg);}
  .nav-tab.active{color:var(--accent);border-bottom-color:var(--accent);}
  .nav-tab .badge{background:var(--accent);color:#000;font-size:11px;font-weight:800;padding:2px 6px;border-radius:99px;min-width:20px;text-align:center;}

  /* BUTTONS */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 28px; border-radius: 12px; font-family: inherit; font-size: 15px; font-weight: 600; cursor: pointer; transition: all .3s; border: none; text-decoration: none; }
  .btn:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .btn:active { transform: translateY(0); }
  
  .btn-gold { background: linear-gradient(135deg, var(--accent), #d97706); color: #000; }
  .btn-gold:hover { box-shadow: 0 8px 28px rgba(245,158,11,.3); }
  
  .btn-ghost { background: rgba(255,255,255,.06); color: var(--fg); border: 1px solid var(--border); }
  .btn-ghost:hover { background: rgba(255,255,255,.1); border-color: var(--accent); }
  
  .btn-red { background: rgba(239,68,68,.12); color: #f87171; border: 1px solid rgba(239,68,68,.25); }
  .btn-red:hover { background: rgba(239,68,68,.2); }
  
  .btn-sm { padding: 8px 16px; font-size: 13px; border-radius: 8px; }

  /* SCREENS */
  .screen{display:none;position:relative;z-index:1;min-height:calc(100vh - 52px);padding:24px 20px 40px;animation:fadeIn .45s ease;}
  .screen.active{display:flex;flex-direction:column;align-items:center;}
  @keyframes fadeIn{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}
  @keyframes slideUp{from{opacity:0;transform:translateY(30px);}to{opacity:1;transform:translateY(0);}}
  @keyframes shake{0%,100%{transform:translateX(0);}20%{transform:translateX(-8px);}40%{transform:translateX(8px);}60%{transform:translateX(-4px);}80%{transform:translateX(4px);}}
  @keyframes float{0%,100%{transform:translateY(0);}50%{transform:translateY(-10px);}}
  @keyframes xpFly{0%{opacity:1;transform:translateY(0) scale(1);}100%{opacity:0;transform:translateY(-60px) scale(1.4);}}
  @keyframes streakFire{0%,100%{text-shadow:0 0 8px rgba(245,158,11,.5);}50%{text-shadow:0 0 24px rgba(245,158,11,.9),0 0 48px rgba(239,68,68,.4);}}
  @keyframes popIn{0%{transform:scale(0);opacity:0;}60%{transform:scale(1.15);}100%{transform:scale(1);opacity:1;}}
  @keyframes ringPulse{0%,100%{box-shadow:0 0 0 0 rgba(245,158,11,.3);}50%{box-shadow:0 0 0 12px rgba(245,158,11,0);}}
  .shake-anim{animation:shake .45s ease;}

  /* WELCOME */
  .welcome-container{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:78vh;text-align:center;max-width:660px;padding-bottom:20px;}
  .welcome-icon{font-size:68px;margin-bottom:20px;animation:float 3s ease-in-out infinite;filter:drop-shadow(0 0 28px rgba(245,158,11,.35));color:var(--accent);}
  .welcome-title{font-size:clamp(40px,7vw,68px);font-weight:800;line-height:1;margin-bottom:6px;background:linear-gradient(135deg,var(--accent),#fbbf24,var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
  .welcome-subtitle{font-size:17px;color:var(--muted);margin-bottom:36px;font-weight:500;letter-spacing:2px;}
  .welcome-tagline{font-size:15px;color:var(--muted);max-width:500px;line-height:1.7;margin-bottom:44px;}
  .name-input-group{display:flex;gap:12px;margin-bottom:28px;width:100%;max-width:420px;}
  .name-input-group input{flex:1;padding:14px 20px;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:12px;color:var(--fg);font-family:inherit;font-size:16px;outline:none;transition:border-color .3s;}
  .name-input-group input:focus{border-color:var(--accent);}
  .stats-bar{display:flex;gap:32px;margin-top:44px;padding:20px 32px;background:var(--card);border-radius:16px;border:1px solid var(--border);backdrop-filter:blur(10px);}
  .stat-item{text-align:center;}
  .stat-value{font-size:28px;font-weight:700;color:var(--accent);}
  .stat-label{font-size:12px;color:var(--muted);letter-spacing:1px;text-transform:uppercase;}

  /* HUB */
  .hub-header{width:100%;max-width:1100px;display:flex;justify-content:space-between;align-items:center;padding:8px 0 20px;flex-wrap:wrap;gap:16px;}
  .hub-profile{display:flex;align-items:center;gap:14px;}
  .avatar{width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent2));display:flex;align-items:center;justify-content:center;font-weight:800;font-size:20px;color:#000;flex-shrink:0;}
  .profile-info h2{font-size:18px;font-weight:700;margin:0;}
  .profile-level{font-size:13px;color:var(--accent);font-weight:600;}
  .xp-bar-container{width:180px;height:7px;background:rgba(255,255,255,.08);border-radius:4px;overflow:hidden;margin-top:4px;}
  .xp-bar-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:4px;transition:width .8s ease;}
  .hub-stats{display:flex;gap:14px;flex-wrap:wrap;}
  .hub-stat{text-align:center;padding:8px 14px;background:var(--card);border-radius:12px;border:1px solid var(--border);}
  .hub-stat-val{font-weight:700;font-size:18px;color:var(--accent);}
  .hub-stat-lbl{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;}
  .hub-title{font-size:34px;font-weight:700;margin-bottom:6px;text-align:center;}
  .hub-subtitle{color:var(--muted);margin-bottom:32px;text-align:center;font-size:15px;}
  .category-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:18px;width:100%;max-width:1100px;margin-bottom:32px;}
  .category-card{position:relative;padding:26px;background:var(--card);border:1px solid var(--border);border-radius:20px;cursor:pointer;transition:all .3s;overflow:hidden;backdrop-filter:blur(10px);touch-action:manipulation;-webkit-tap-highlight-color:transparent;}
  .category-card::before{content:'';position:absolute;top:0;left:0;width:100%;height:4px;border-radius:20px 20px 0 0;}
  .category-card:hover{transform:translateY(-4px);border-color:rgba(255,255,255,.15);box-shadow:var(--shadow);}
  .category-card:active{transform:translateY(-1px);}
  .category-card[data-cat="science"]::before{background:var(--science);}
  .category-card[data-cat="history"]::before{background:var(--history);}
  .category-card[data-cat="geography"]::before{background:var(--geography);}
  .category-card[data-cat="math"]::before{background:var(--math);}
  .category-card[data-cat="language"]::before{background:var(--language);}
  .category-card[data-cat="nature"]::before{background:var(--nature);}
  .category-card[data-cat="culture"]::before{background:var(--culture);}
  .cat-icon{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:14px;}
  .category-card[data-cat="science"] .cat-icon{background:rgba(6,182,212,.15);color:var(--science);}
  .category-card[data-cat="history"] .cat-icon{background:rgba(245,158,11,.15);color:var(--history);}
  .category-card[data-cat="geography"] .cat-icon{background:rgba(16,185,129,.15);color:var(--geography);}
  .category-card[data-cat="math"] .cat-icon{background:rgba(239,68,68,.15);color:var(--math);}
  .category-card[data-cat="language"] .cat-icon{background:rgba(168,85,247,.15);color:var(--language);}
  .category-card[data-cat="nature"] .cat-icon{background:rgba(34,197,94,.15);color:var(--nature);}
  .category-card[data-cat="culture"] .cat-icon{background:rgba(236,72,153,.15);color:var(--culture);}
  .cat-name{font-size:21px;font-weight:700;margin-bottom:5px;font-family:'Syne',sans-serif;}
  .cat-desc{font-size:13px;color:var(--muted);line-height:1.5;margin-bottom:14px;}
  
  .cat-levels-badge{display:flex;gap:4px;margin-bottom:12px;}
  .lvl-badge{font-size:10px;padding:2px 6px;border-radius:4px;background:rgba(255,255,255,.05);color:var(--muted);}
  .lvl-badge.done{background:rgba(16,185,129,.15);color:var(--accent2);}
  .lvl-badge.next{background:rgba(245,158,11,.15);color:var(--accent);}

  .cat-meta{display:flex;justify-content:space-between;align-items:center;}
  .cat-progress{font-size:13px;color:var(--muted);font-weight:500;}
  
  /* LEVEL SELECT */
  .level-select-container{width:100%;max-width:800px;}
  .ls-header{display:flex;align-items:center;gap:16px;margin-bottom:30px;}
  .ls-icon{width:60px;height:60px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:26px;}
  .ls-title{font-size:32px;font-family:'Syne',sans-serif;font-weight:700;}
  .ls-desc{color:var(--muted);font-size:15px;}
  .level-list{display:flex;flex-direction:column;gap:16px;}
  .level-card{display:flex;align-items:center;justify-content:space-between;padding:20px 24px;background:var(--card);border:1px solid var(--border);border-radius:16px;transition:all .3s;}
  .level-card.available{cursor:pointer;border-color:rgba(245,158,11,.3);}
  .level-card.available:hover{transform:translateX(6px);background:rgba(245,158,11,.05);}
  .level-card.completed{cursor:pointer;border-color:rgba(16,185,129,.3);background:rgba(16,185,129,.05);}
  .level-card.completed:hover{transform:translateX(6px);}
  .level-card.locked{opacity:0.5;filter:grayscale(1);pointer-events:none;}
  .lc-left{display:flex;align-items:center;gap:16px;}
  .lc-num{font-family:'Syne',sans-serif;font-size:24px;font-weight:700;color:var(--muted);width:30px;text-align:center;}
  .level-card.available .lc-num{color:var(--accent);}
  .level-card.completed .lc-num{color:var(--accent2);}
  .lc-info h3{font-size:18px;margin-bottom:4px;}
  .lc-info p{font-size:13px;color:var(--muted);}
  .lc-right{display:flex;align-items:center;gap:16px;}
  .lc-stars{display:flex;gap:4px;color:rgba(255,255,255,0.1);font-size:16px;}
  .lc-stars .lit{color:var(--accent);}
  .lc-status{font-size:20px;color:var(--muted);}
  .level-card.completed .lc-status{color:var(--accent2);}

  /* QUIZ */
  .quiz-container{width:100%;max-width:800px;padding-top:8px;}
  .quiz-top-bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px;}
  .quiz-category-label{display:flex;align-items:center;gap:10px;font-weight:700;font-size:17px;}
  .quiz-category-dot{width:12px;height:12px;border-radius:50%;}
  .quiz-stats-row{display:flex;gap:12px;margin-bottom:20px;flex-wrap:wrap;}
  .quiz-stat-pill{display:flex;align-items:center;gap:7px;padding:7px 14px;background:var(--card);border:1px solid var(--border);border-radius:10px;font-size:14px;}
  .quiz-stat-pill i{color:var(--accent);font-size:13px;}
  .quiz-stat-pill .val{font-weight:700;}
  .streak-pill.hot .val{animation:streakFire .6s ease infinite;color:#ef4444;}
  
  .progress-outer{width:100%;height:6px;background:rgba(255,255,255,.06);border-radius:3px;margin-bottom:28px;overflow:hidden;}
  .progress-inner{height:100%;background:var(--accent3);border-radius:3px;transition:width .3s ease;}

  .timer-container{width:100%;height:4px;background:rgba(255,255,255,.06);border-radius:2px;margin-bottom:28px;overflow:hidden;}
  .timer-fill{height:100%;background:var(--accent2);border-radius:2px;transition:width .1s linear,background .3s;}
  .timer-fill.warning{background:var(--accent);}
  .timer-fill.danger{background:var(--danger);}
  
  .question-number{font-size:13px;color:var(--muted);text-transform:uppercase;letter-spacing:2px;margin-bottom:10px;font-weight:600;}
  .question-text{font-size:clamp(20px,3.5vw,30px);font-weight:700;line-height:1.4;margin-bottom:32px;font-family:'Syne',sans-serif;}
  .options-list{display:flex;flex-direction:column;gap:12px;margin-bottom:20px;}
  .option-btn{display:flex;align-items:center;gap:14px;padding:16px 22px;background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:14px;cursor:pointer;transition:all .22s;font-family:inherit;font-size:15px;color:var(--fg);text-align:left;width:100%;font-weight:500;}
  .option-btn:hover:not(.disabled){background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.2);transform:translateX(4px);}
  .option-btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}
  .option-letter{width:34px;height:34px;border-radius:9px;background:rgba(255,255,255,.06);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;flex-shrink:0;transition:all .3s;}
  .option-btn.correct{background:rgba(16,185,129,.12);border-color:rgba(16,185,129,.4);}
  .option-btn.correct .option-letter{background:var(--accent2);color:#000;}
  .option-btn.incorrect{background:rgba(239,68,68,.12);border-color:rgba(239,68,68,.4);}
  .option-btn.incorrect .option-letter{background:#ef4444;color:#fff;}
  .option-btn.disabled{cursor:default;pointer-events:none;}
  .option-btn.disabled:not(.correct):not(.incorrect){opacity:.5;}
  .explanation-box{padding:18px 22px;background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.2);border-radius:14px;margin-top:16px;animation:slideUp .35s ease;}
  .explanation-box .label{font-weight:700;color:var(--accent);font-size:13px;text-transform:uppercase;letter-spacing:1px;margin-bottom:6px;display:flex;align-items:center;gap:6px;}
  .explanation-box .text{font-size:14px;line-height:1.65;color:var(--fg);}

  /* RESULTS */
  .results-container{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:75vh;text-align:center;max-width:600px;}
  .results-icon{font-size:60px;margin-bottom:20px;animation:popIn .5s ease;}
  .results-title{font-size:40px;font-weight:800;margin-bottom:6px;}
  .results-subtitle{color:var(--muted);font-size:15px;margin-bottom:24px;}
  
  .level-complete-banner { display: none; align-items: center; gap: 10px; background: rgba(16,185,129,0.15); color: #34d399; padding: 12px 24px; border-radius: 12px; border: 1px solid rgba(16,185,129,0.3); font-weight: 600; margin-bottom: 24px; animation: slideUp .4s ease; }
  .level-complete-banner.show { display: flex; }
  
  .results-stars { display: flex; gap: 8px; font-size: 32px; color: rgba(255,255,255,0.1); margin-bottom: 30px; }
  .results-stars .fas { transition: color 0.4s ease, transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); transform: scale(0.8); }
  .results-stars .lit { color: var(--accent); transform: scale(1.1); filter: drop-shadow(0 0 10px rgba(245,158,11,0.6)); }

  .results-score-ring{width:150px;height:150px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-direction:column;margin-bottom:28px;position:relative;}
  .results-score-ring svg{position:absolute;top:0;left:0;transform:rotate(-90deg);}
  .score-ring-value{font-size:40px;font-weight:800;}
  .score-ring-label{font-size:12px;color:var(--muted);}
  .results-details{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;width:100%;margin-bottom:28px;}
  .result-detail-box{padding:14px;background:var(--card);border:1px solid var(--border);border-radius:14px;}
  .result-detail-box .val{font-size:26px;font-weight:700;font-family:'Syne',sans-serif;}
  .result-detail-box .lbl{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;}
  .results-actions{display:flex;gap:14px;flex-wrap:wrap;justify-content:center;}

  /* ACHIEVEMENTS */
  .achievements-header{width:100%;max-width:1100px;display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;}
  .achievements-header h2{font-size:34px;font-weight:700;}
  .achievements-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px;width:100%;max-width:1100px;}
  .achievement-card{position:relative;padding:20px;background:var(--card);border:1px solid var(--border);border-radius:16px;text-align:center;transition:all .3s;}
  .achievement-card.unlocked{border-color:rgba(245,158,11,.3);background:rgba(245,158,11,.05);}
  .achievement-card.locked{opacity:.35;filter:grayscale(.5);}
  .achievement-icon{font-size:34px;margin-bottom:10px;}
  .achievement-card.unlocked .achievement-icon{color:var(--accent);}
  .achievement-name{font-weight:700;font-size:15px;margin-bottom:3px;}
  .achievement-desc{font-size:12px;color:var(--muted);line-height:1.4;}
  .badge-new { position: absolute; top: -8px; right: -8px; background: var(--accent2); color: #000; font-size: 10px; font-weight: 800; padding: 4px 8px; border-radius: 8px; display: none; }
  .achievement-card.new-unlock .badge-new { display: block; animation: popIn 0.3s ease; }

  /* REVIEW */
  .review-container{width:100%;max-width:800px;}
  .review-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;}
  .review-header h2{font-size:30px;font-weight:700;}
  .review-list{display:flex;flex-direction:column;gap:16px;width:100%;}
  .review-item{padding:20px;background:var(--card);border:1px solid var(--border);border-radius:16px;}
  .review-item.was-correct{border-left:3px solid var(--accent2);}
  .review-item.was-wrong{border-left:3px solid var(--danger);}
  .review-q{font-weight:600;font-size:15px;margin-bottom:8px;line-height:1.5;}
  .review-answers{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px;}
  .review-answer{padding:5px 12px;border-radius:8px;font-size:13px;font-weight:500;}
  .review-answer.correct-a{background:rgba(16,185,129,.15);color:#34d399;border:1px solid rgba(16,185,129,.3);}
  .review-answer.wrong-a{background:rgba(239,68,68,.15);color:#f87171;border:1px solid rgba(239,68,68,.3);}
  .review-answer.user-a{background:rgba(245,158,11,.15);color:#fbbf24;border:1px solid rgba(245,158,11,.3);}
  .review-expl{font-size:13px;color:var(--muted);line-height:1.6;}

  /* PROFILE */
  .profile-container{width:100%;max-width:600px;display:flex;flex-direction:column;align-items:center;}
  .profile-big-avatar{width:90px;height:90px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent2));display:flex;align-items:center;justify-content:center;font-weight:800;font-size:38px;color:#000;margin-bottom:16px;animation:ringPulse 2s ease infinite;}
  .profile-name{font-size:28px;font-weight:700;margin-bottom:4px;font-family:'Syne',sans-serif;}
  .profile-level-display{color:var(--accent);font-weight:600;font-size:16px;margin-bottom:20px;}
  .profile-xp-big{width:100%;max-width:400px;margin-bottom:32px;}
  .profile-xp-label{display:flex;justify-content:space-between;font-size:13px;color:var(--muted);margin-bottom:6px;}
  .profile-xp-bar{width:100%;height:12px;background:rgba(255,255,255,.08);border-radius:6px;overflow:hidden;}
  .profile-xp-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:6px;transition:width 1s ease;}
  .profile-stats-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;width:100%;margin-bottom:32px;}
  .profile-stat-card{padding:18px;background:var(--card);border:1px solid var(--border);border-radius:14px;text-align:center;}
  .profile-stat-card .pval{font-size:28px;font-weight:700;color:var(--accent);font-family:'Syne',sans-serif;}
  .profile-stat-card .plbl{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;}
  .profile-actions{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;}

  /* MODALS & TOASTS */
  .toast{position:fixed;top:20px;right:20px;padding:14px 22px;background:rgba(17,24,39,.95);border:1px solid var(--accent);border-radius:14px;z-index:200;animation:slideUp .3s ease;backdrop-filter:blur(12px);display:flex;align-items:center;gap:10px;font-weight:600;font-size:14px;max-width:340px;box-shadow:var(--shadow);}
  .toast i{color:var(--accent);font-size:18px;flex-shrink:0;}
  .xp-fly{position:fixed;font-weight:800;font-size:22px;color:var(--accent);pointer-events:none;z-index:100;animation:xpFly 1s ease forwards;text-shadow:0 0 10px rgba(245,158,11,.5);}

  .modal-bg { position: fixed; inset: 0; z-index: 300; background: rgba(0,0,0,.6); backdrop-filter: blur(4px); display: none; align-items: center; justify-content: center; }
  .modal-bg.open { display: flex; }
  .modal-box { background: var(--bg2); border: 1px solid var(--border); border-radius: 20px; padding: 32px; max-width: 400px; width: 90%; text-align: center; box-shadow: var(--shadow); }

  /* RESPONSIVE */
  @media(max-width:700px){
    .category-grid{grid-template-columns:1fr;}
    .hub-header{flex-direction:column;align-items:flex-start;}
    .hub-stats{width:100%;justify-content:space-between;}
    .stats-bar{flex-direction:column;gap:14px;}
    .name-input-group{flex-direction:column;}
    .results-details{grid-template-columns:1fr;}
    .results-actions{flex-direction:column;width:100%;}
    .quiz-stats-row{gap:8px;}
    .nav-tab{padding:12px 8px;font-size:13px;}
    .nav-tab span.tab-label{display:none;}
    .profile-stats-grid{grid-template-columns:1fr;}
    .achievements-grid{grid-template-columns:1fr 1fr;}
  }
  @media(max-width:440px){ .achievements-grid{grid-template-columns:1fr;} }
  @media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important;}}
</style>
</head>
<body>
<canvas id="bgCanvas" aria-hidden="true"></canvas>

<!-- NAV -->
<nav class="main-nav" id="mainNav" style="display:none;" role="tablist">
  <button class="nav-tab active" data-tab="hub" onclick="switchTab('hub')" role="tab">
    <i class="fas fa-compass"></i><span class="tab-label">Realms</span>
  </button>
  <button class="nav-tab" data-tab="achievements" onclick="switchTab('achievements')" role="tab">
    <i class="fas fa-trophy"></i><span class="tab-label">Achievements</span>
    <span class="badge" id="achieveBadge" style="display:none;">0</span>
  </button>
  <button class="nav-tab" data-tab="profile" onclick="switchTab('profile')" role="tab">
    <i class="fas fa-user"></i><span class="tab-label">Profile</span>
  </button>
</nav>

<!-- WELCOME -->
<section id="sWelcome" class="screen active" role="region">
  <div class="welcome-container">
    <div class="welcome-icon"><i class="fas fa-brain"></i></div>
    <h1 class="welcome-title">Cerebrum Quest</h1>
    <p class="welcome-subtitle">KNOWLEDGE ADVENTURE</p>
    <p class="welcome-tagline">Explore seven realms of knowledge. Ascend the ranks from Apprentice to Master. Every answer teaches you something new.</p>
    <div class="name-input-group">
      <input type="text" id="playerNameInput" placeholder="Enter your name, explorer..." maxlength="20">
      <button class="btn btn-gold" id="startBtn">Begin Quest</button>
    </div>
    <div class="stats-bar">
      <div class="stat-item"><div class="stat-value">7</div><div class="stat-label">Realms</div></div>
      <div class="stat-item"><div class="stat-value">35</div><div class="stat-label">Levels</div></div>
      <div class="stat-item"><div class="stat-value">15</div><div class="stat-label">Achievements</div></div>
    </div>
  </div>
</section>

<!-- HUB -->
<section id="sHub" class="screen" role="region">
  <header class="hub-header">
    <div class="hub-profile">
      <div class="avatar" id="hubAvatar">A</div>
      <div class="profile-info">
        <h2 id="hubName">Explorer</h2>
        <div class="profile-level" id="hubLevel">Level 1 — Novice</div>
        <div class="xp-bar-container"><div class="xp-bar-fill" id="hubXpBar" style="width:0%"></div></div>
      </div>
    </div>
    <div class="hub-stats">
      <div class="hub-stat"><div class="hub-stat-val" id="hudLevels">0/35</div><div class="hub-stat-lbl">Levels</div></div>
      <div class="hub-stat"><div class="hub-stat-val" id="hubTotalXP">0</div><div class="hub-stat-lbl">Total XP</div></div>
      <div class="hub-stat"><div class="hub-stat-val" id="hubAccuracy">0%</div><div class="hub-stat-lbl">Accuracy</div></div>
    </div>
  </header>
  <h2 class="hub-title">Choose Your Realm</h2>
  <p class="hub-subtitle">Master each realm level by level</p>
  <div class="category-grid" id="categoryGrid"></div>
</section>

<!-- LEVEL SELECT -->
<section id="sLevelSelect" class="screen" role="region">
  <div class="level-select-container">
    <button class="btn btn-ghost btn-sm" onclick="showScreen('sHub')" style="margin-bottom:20px;"><i class="fas fa-arrow-left"></i> Back to Realms</button>
    <div class="ls-header">
      <div class="ls-icon" id="lsIcon"></div>
      <div>
        <h2 class="ls-title" id="lsTitle">Realm Name</h2>
        <p class="ls-desc" id="lsDesc">Description</p>
      </div>
    </div>
    <div class="level-list" id="levelList"></div>
  </div>
</section>

<!-- QUIZ -->
<section id="sQuiz" class="screen" role="region">
  <div class="quiz-container">
    <div class="quiz-top-bar">
      <div class="quiz-category-label">
        <div class="quiz-category-dot" id="quizCatDot"></div>
        <span id="quizCatName">Science — Level 3</span>
      </div>
      <button class="btn btn-ghost btn-sm" id="quizBackBtn" style="color:var(--muted);"><i class="fas fa-times"></i> Quit</button>
    </div>
    <div class="quiz-stats-row">
      <div class="quiz-stat-pill"><i class="fas fa-bolt"></i><span>XP: <span class="val" id="quizXP">0</span></span></div>
      <div class="quiz-stat-pill streak-pill" id="streakPill"><i class="fas fa-fire"></i><span>Streak: <span class="val" id="quizStreak">0</span></span></div>
      <div class="quiz-stat-pill"><i class="fas fa-star"></i><span><span class="val" id="quizScore">0</span>/<span id="quizTotal">0</span></span></div>
      <div class="quiz-stat-pill"><i class="fas fa-clock"></i><span id="quizTimerText">20s</span></div>
    </div>
    
    <div class="progress-outer"><div class="progress-inner" id="qProgressBar" style="width:0%"></div></div>
    <div class="timer-container"><div class="timer-fill" id="timerFill" style="width:100%"></div></div>
    
    <div class="question-number" id="questionNumber">Question 1 of 5</div>
    <div class="question-text" id="questionText">Loading...</div>
    <div class="options-list" id="optionsList"></div>
    <div id="explanationArea"></div>
  </div>
</section>

<!-- RESULTS -->
<section id="sResults" class="screen" role="region">
  <div class="results-container">
    <div class="results-icon" id="resultsIcon"><i class="fas fa-trophy"></i></div>
    <h2 class="results-title" id="resultsTitle">Well Done!</h2>
    <p class="results-subtitle" id="resultsSubtitle">You completed the level</p>
    
    <div class="level-complete-banner" id="levelCompleteBanner">
      <i class="fas fa-check-circle"></i> <span id="bannerText">Level Complete!</span>
    </div>
    
    <div class="results-stars" id="resultsStars">
      <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
    </div>

    <div class="results-score-ring" id="resultsRing">
      <svg width="150" height="150"><circle cx="75" cy="75" r="68" fill="none" stroke="rgba(255,255,255,.06)" stroke-width="7"/><circle cx="75" cy="75" r="68" fill="none" stroke="var(--accent2)" stroke-width="7" stroke-dasharray="427.26" stroke-dashoffset="427.26" stroke-linecap="round" id="scoreCircle" style="transition:stroke-dashoffset 1.2s cubic-bezier(.2,1,.3,1)"/></svg>
      <div class="score-ring-value" id="scoreRingValue">0%</div>
      <div class="score-ring-label">Accuracy</div>
    </div>
    
    <div class="results-details">
      <div class="result-detail-box"><div class="val" style="color:var(--accent)" id="resXP">0</div><div class="lbl">XP Earned</div></div>
      <div class="result-detail-box"><div class="val" style="color:var(--accent2)" id="resCorrect">0</div><div class="lbl">Correct</div></div>
      <div class="result-detail-box"><div class="val" style="color:#ef4444" id="resWrong">0</div><div class="lbl">Wrong</div></div>
    </div>
    <div class="results-actions">
      <button class="btn btn-gold" id="nextLvlBtn" style="display:none;">Next Level <i class="fas fa-arrow-right"></i></button>
      <button class="btn btn-ghost" id="retryBtn"><i class="fas fa-rotate-right"></i> Play Again</button>
      <button class="btn btn-ghost" id="reviewBtn"><i class="fas fa-eye"></i> Review</button>
      <button class="btn btn-ghost" id="backHubBtn"><i class="fas fa-compass"></i> Realms</button>
    </div>
  </div>
</section>

<!-- REVIEW -->
<section id="sReview" class="screen" role="region">
  <div class="review-container">
    <div class="review-header">
      <h2>Answer Review</h2>
      <button class="btn btn-ghost btn-sm" id="reviewBackBtn"><i class="fas fa-arrow-left"></i> Back</button>
    </div>
    <div class="review-list" id="reviewList"></div>
  </div>
</section>

<!-- ACHIEVEMENTS -->
<section id="sAchievements" class="screen" role="region">
  <div style="width:100%;max-width:1100px;">
    <div class="achievements-header">
      <h2>Achievements</h2>
      <span id="achieveCount" style="color:var(--muted);font-size:15px;font-weight:600;">0 / 15 Unlocked</span>
    </div>
    <div class="achievements-grid" id="achievementsGrid"></div>
  </div>
</section>

<!-- PROFILE -->
<section id="sProfile" class="screen" role="region">
  <div class="profile-container">
    <div class="profile-big-avatar" id="profileBigAvatar">A</div>
    <div class="profile-name" id="profileName">Explorer</div>
    <div class="profile-level-display" id="profileLevel">Level 1 — Novice</div>
    <div class="profile-xp-big">
      <div class="profile-xp-label"><span id="profileXpCurrent">0 XP</span><span id="profileXpNeeded">150 XP</span></div>
      <div class="profile-xp-bar"><div class="profile-xp-fill" id="profileXpFill" style="width:0%"></div></div>
    </div>
    <div class="profile-stats-grid" id="profileStatsGrid"></div>
    <div class="profile-actions">
      <button class="btn btn-ghost" id="profileEditBtn"><i class="fas fa-pen"></i> Edit Name</button>
      <button class="btn btn-red" id="profileResetBtn"><i class="fas fa-rotate-left"></i> Reset Progress</button>
    </div>
  </div>
</section>

<!-- Confirm Modal -->
<div id="confirmModal" class="modal-bg">
  <div class="modal-box">
    <h3 id="confirmTitle" style="font-size:20px;font-weight:700;margin-bottom:10px;">Are you sure?</h3>
    <p id="confirmMsg" style="color:var(--muted);margin-bottom:24px;font-size:14px;line-height:1.6;">This action cannot be undone.</p>
    <div style="display:flex;gap:12px;justify-content:center;">
      <button class="btn btn-ghost" id="confirmCancelBtn">Cancel</button>
      <button class="btn btn-red" id="confirmOkBtn">Confirm</button>
    </div>
  </div>
</div>

<!-- Name Modal -->
<div id="nameModal" class="modal-bg">
  <div class="modal-box">
    <h3 style="font-size:20px;font-weight:700;margin-bottom:16px;">Edit Name</h3>
    <input type="text" id="editNameInput" maxlength="20" style="width:100%;padding:12px 16px;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:10px;color:var(--fg);font-family:inherit;font-size:16px;outline:none;margin-bottom:20px;" placeholder="New name...">
    <div style="display:flex;gap:12px;justify-content:center;">
      <button class="btn btn-ghost" id="nameCancelBtn">Cancel</button>
      <button class="btn btn-gold" id="nameSaveBtn">Save</button>
    </div>
  </div>
</div>

<script>
__QUESTIONS_JSON__

const CATEGORY_META = {
  science:{name:"Science",icon:"fa-flask",desc:"Physics, chemistry, biology, and the universe",color:"var(--science)"},
  history:{name:"History",icon:"fa-landmark",desc:"Civilizations, wars, and humanity",color:"var(--history)"},
  geography:{name:"Geography",icon:"fa-earth-americas",desc:"Countries, oceans, and the world",color:"var(--geography)"},
  math:{name:"Mathematics",icon:"fa-square-root-variable",desc:"Numbers, patterns, and logic",color:"var(--math)"},
  language:{name:"Language",icon:"fa-language",desc:"Words, grammar, and communication",color:"var(--language)"},
  nature:{name:"Nature",icon:"fa-leaf",desc:"Animals, ecosystems, and the living world",color:"var(--nature)"},
  culture:{name:"Culture",icon:"fa-masks-theater",desc:"Art, traditions, and human creativity",color:"var(--culture)"}
};

const LVL_NAMES = ["Apprentice", "Explorer", "Journeyman", "Adept", "Master"];
const PLAYER_RANKS = [
  { minLvl: 1, name: "Novice" },
  { minLvl: 5, name: "Scholar" },
  { minLvl: 10, name: "Sage" },
  { minLvl: 15, name: "Polymath" },
  { minLvl: 20, name: "Mastermind" },
  { minLvl: 25, name: "Luminary" },
  { minLvl: 30, name: "Legend" }
];
const XP_MAP = { 1: 15, 2: 25, 3: 40, 4: 60, 5: 90 };
const TIMER_DUR = { 1: 30, 2: 25, 3: 20, 4: 15, 5: 12 };

let S = {
  playerName:"Explorer", totalXP:0, curLevelNum:1, bestStreak:0,
  totalCorrect:0, totalAnswered:0, totalQuizzes:0, perfectQuizzes:0, hardCorrect:0, fastAnswer:0,
  curCat:null, curLevel:1,
  categoryData: {},
  tripleStars: 0, lvl5Cleared: 0, levelsCleared: 0, realmsMastered: 0,
  newAchievements: new Set(), unlockedAchievements: new Set(),
  qs: [], qIndex: 0, quizScore: 0, quizStreak: 0, quizXP: 0,
  quizStartTime: 0, timerInterval: null, timeLeft: 0, questionAnswered: false, lastQuizAnswers: [],
  currentTab: "hub", quizStarted: false
};

// init category data
Object.keys(CATEGORY_META).forEach(c => {
  S.categoryData[c] = { levelData: Array.from({length:5},()=>({stars:0,completed:false})) };
});

const ACHIEVEMENTS = [
  {id:"first_step",name:"First Step",desc:"Complete your first level",icon:"fa-shoe-prints",check:s=>s.levelsCleared>=1},
  {id:"curious_mind",name:"Curious Mind",desc:"Play 3 different categories",icon:"fa-magnifying-glass",check:s=>Object.values(s.categoryData).filter(c=>c.levelData[0].completed||c.levelData[0].stars>0).length>=3},
  {id:"streak_5",name:"On Fire",desc:"Get a 5-answer streak",icon:"fa-fire",check:s=>s.bestStreak>=5},
  {id:"streak_10",name:"Unstoppable",desc:"Get a 10-answer streak",icon:"fa-meteor",check:s=>s.bestStreak>=10},
  {id:"perfect",name:"Perfectionist",desc:"Score 3 stars on any level",icon:"fa-crown",check:s=>s.tripleStars>=1},
  {id:"scholar",name:"Scholar",desc:"Earn 500 total XP",icon:"fa-graduation-cap",check:s=>s.totalXP>=500},
  {id:"polymath",name:"Polymath",desc:"Play all 7 categories",icon:"fa-brain",check:s=>Object.values(s.categoryData).filter(c=>c.levelData[0].completed||c.levelData[0].stars>0).length>=7},
  {id:"mastery",name:"Realm Master",desc:"Complete all 5 levels in one category",icon:"fa-gem",check:s=>s.realmsMastered>=1},
  {id:"level5",name:"The Summit",desc:"Complete any Level 5",icon:"fa-mountain",check:s=>s.lvl5Cleared>=1},
  {id:"veteran",name:"Veteran",desc:"Clear 10 levels",icon:"fa-medal",check:s=>s.levelsCleared>=10},
  {id:"all_realms",name:"Grand Master",desc:"Complete all 35 levels",icon:"fa-globe",check:s=>s.levelsCleared>=35},
  {id:"mastermind",name:"Mastermind",desc:"Earn 2000 total XP",icon:"fa-chess-knight",check:s=>s.totalXP>=2000},
  {id:"speed_demon",name:"Speed Demon",desc:"Answer in under 3 seconds",icon:"fa-bolt",check:s=>s.fastAnswer>=1},
  {id:"encyclopedia",name:"Encyclopedia",desc:"Answer 100 questions total",icon:"fa-book",check:s=>s.totalAnswered>=100},
  {id:"survivor",name:"Survivor",desc:"Answer a Level 4+ question correctly",icon:"fa-shield-halved",check:s=>s.hardCorrect>=1}
];

// Bg Particles
const canvas=document.getElementById('bgCanvas'), ctx=canvas.getContext('2d');
let particles=[], mouseX=0, mouseY=0;
function resizeCanvas(){canvas.width=window.innerWidth;canvas.height=window.innerHeight;}
function initParticles(){
  particles=[]; const count=Math.min(70,Math.floor(window.innerWidth*window.innerHeight/18000));
  for(let i=0;i<count;i++) particles.push({x:Math.random()*canvas.width,y:Math.random()*canvas.height,vx:(Math.random()-.5)*.35,vy:(Math.random()-.5)*.35,r:Math.random()*1.8+.5,alpha:Math.random()*.25+.08,color:['#f59e0b','#10b981','#06b6d4','#a855f7'][Math.floor(Math.random()*4)]});
}
function animateBg(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  const grd=ctx.createRadialGradient(mouseX,mouseY,0,mouseX,mouseY,350);
  grd.addColorStop(0,'rgba(245,158,11,0.025)'); grd.addColorStop(1,'rgba(0,0,0,0)');
  ctx.fillStyle=grd; ctx.fillRect(0,0,canvas.width,canvas.height);
  for(let i=0;i<particles.length;i++){
    let p=particles[i]; p.x+=p.vx; p.y+=p.vy;
    if(p.x<0)p.x=canvas.width; if(p.x>canvas.width)p.x=0; if(p.y<0)p.y=canvas.height; if(p.y>canvas.height)p.y=0;
    ctx.beginPath(); ctx.arc(p.x,p.y,Math.max(.5,p.r),0,Math.PI*2); ctx.fillStyle=p.color; ctx.globalAlpha=p.alpha; ctx.fill();
    for(let j=i+1;j<particles.length;j++){
      let p2=particles[j], dx=p.x-p2.x, dy=p.y-p2.y, dist=Math.sqrt(dx*dx+dy*dy);
      if(dist<110){ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(p2.x,p2.y);ctx.strokeStyle=p.color;ctx.globalAlpha=(1-dist/110)*.06;ctx.lineWidth=.5;ctx.stroke();}
    }
  }
  ctx.globalAlpha=1; requestAnimationFrame(animateBg);
}
window.addEventListener('resize',()=>{resizeCanvas();initParticles();});
window.addEventListener('mousemove',e=>{mouseX=e.clientX;mouseY=e.clientY;});
resizeCanvas(); initParticles(); animateBg();

// Audio
let aCtx=null; function getAudioCtx(){if(!aCtx)aCtx=new(window.AudioContext||window.webkitAudioContext)();return aCtx;}
function playTone(freq,dur,type='sine',vol=.12){
  try{let a=getAudioCtx(),o=a.createOscillator(),g=a.createGain();o.type=type;o.frequency.value=freq;g.gain.value=vol;g.gain.exponentialRampToValueAtTime(.001,a.currentTime+dur);o.connect(g);g.connect(a.destination);o.start();o.stop(a.currentTime+dur);}catch(e){}
}
function sfxC(){playTone(523,.1);setTimeout(()=>playTone(659,.1),80);setTimeout(()=>playTone(784,.15),160);}
function sfxW(){playTone(200,.25,'sawtooth',.08);}
function sfxK(){playTone(880,.05,'sine',.06);}
function sfxA(){playTone(784,.08);setTimeout(()=>playTone(988,.08),80);setTimeout(()=>playTone(1175,.12),160);setTimeout(()=>playTone(1568,.2),260);}
function sfxT(){playTone(300,.15,'triangle',.08);setTimeout(()=>playTone(220,.3,'triangle',.06),150);}

// Navigation
function showScreen(id){
  ['sHub','sLevelSelect','sQuiz','sResults','sReview','sAchievements','sProfile','sWelcome'].forEach(s=>document.getElementById(s).classList.remove('active'));
  document.getElementById(id).classList.add('active');
  let nav = document.getElementById('mainNav');
  nav.style.display = (id === 'sWelcome' || id === 'sQuiz') ? 'none' : 'flex';
  
  if(id==='sHub') updateHub();
  if(id==='sAchievements') renderAchievements();
  if(id==='sProfile') renderProfile();
  
  ['hub','achievements','profile'].forEach(t=>document.querySelector(`[data-tab="${t}"]`)?.classList.toggle('active', id==='s'+t.charAt(0).toUpperCase()+t.slice(1)));
  if(id==='sAchievements'){ S.newAchievements.clear(); updateBadge(); }
}
function switchTab(t){ sfxK(); showScreen('s'+t.charAt(0).toUpperCase()+t.slice(1)); }
function updateBadge(){
  let b=document.getElementById('achieveBadge');
  if(S.newAchievements.size>0){b.style.display='inline-block';b.textContent=S.newAchievements.size;}else b.style.display='none';
}
function getRank(lvl){ return PLAYER_RANKS.slice().reverse().find(r=>lvl>=r.minLvl).name; }
function calcLevel(){
  let l=1, xp=0; while(xp+l*150<=S.totalXP){xp+=l*150;l++;}
  return {lvl:l, xpIn:S.totalXP-xp, xpNeed:l*150, pct:Math.min(100,((S.totalXP-xp)/(l*150))*100)};
}

// Welcome
document.getElementById('startBtn').addEventListener('click',startGame);

// Detect mobile keyboard to simplify welcome layout
if('visualViewport' in window){
  window.visualViewport.addEventListener('resize',()=>{
    const vkOpen=window.visualViewport.height<window.innerHeight*0.8;
    document.body.classList.toggle('keyboard-open',vkOpen);
  });
}
function startGame(){
  let n=document.getElementById('playerNameInput').value.trim();
  if(n) S.playerName=n;
  let init=S.playerName.charAt(0).toUpperCase();
  document.getElementById('hubAvatar').textContent=init; document.getElementById('hubName').textContent=S.playerName;
  document.getElementById('profileBigAvatar').textContent=init; document.getElementById('profileName').textContent=S.playerName;
  sfxK(); showScreen('sHub');
}

// Hub
function updateHub(){
  let li=calcLevel(); S.curLevelNum=li.lvl;
  document.getElementById('hubLevel').textContent=`Level ${li.lvl} — ${getRank(li.lvl)}`;
  document.getElementById('hubXpBar').style.width=li.pct+'%';
  document.getElementById('hubTotalXP').textContent=S.totalXP;
  document.getElementById('hudLevels').textContent=`${S.levelsCleared}/35`;
  document.getElementById('hubAccuracy').textContent=(S.totalAnswered>0?Math.round((S.totalCorrect/S.totalAnswered)*100):0)+'%';
  
  let grid=document.getElementById('categoryGrid'); grid.innerHTML='';
  Object.keys(CATEGORY_META).forEach(cat=>{
    let m=CATEGORY_META[cat], ld=S.categoryData[cat].levelData;
    let done=ld.filter(l=>l.completed).length, stars=ld.reduce((a,b)=>a+b.stars,0);
    
    let badgesHtml = ld.map((l,i) => {
      if(l.completed) return `<span class="lvl-badge done"><i class="fas fa-check"></i> L${i+1}</span>`;
      if(i===0 || ld[i-1].completed) return `<span class="lvl-badge next"><i class="fas fa-play"></i> L${i+1}</span>`;
      return `<span class="lvl-badge"><i class="fas fa-lock"></i> L${i+1}</span>`;
    }).join('');

    let card=document.createElement('div'); card.className='category-card'; card.setAttribute('data-cat',cat);
    card.innerHTML=`<div class="cat-icon"><i class="fas ${m.icon}"></i></div>
      <div class="cat-name">${m.name}</div>
      <div class="cat-levels-badge">${badgesHtml}</div>
      <div class="cat-desc">${m.desc}</div>
      <div class="cat-meta">
        <span class="cat-progress">${done}/5 levels · ${stars}★</span>
        <div style="width:70px;height:4px;background:rgba(255,255,255,.08);border-radius:2px;overflow:hidden;"><div style="height:100%;width:${(done/5)*100}%;background:${m.color}"></div></div>
      </div>`;
    card.onclick=()=>{ sfxK(); openLevelSelect(cat); };
    grid.appendChild(card);
  });
}

// Level Select
function openLevelSelect(cat){
  S.curCat=cat; let m=CATEGORY_META[cat], ld=S.categoryData[cat].levelData;
  document.getElementById('lsIcon').innerHTML=`<i class="fas ${m.icon}"></i>`;
  document.getElementById('lsIcon').style.background=`rgba(${m.color.replace('var(--','').replace(')','')},0.15)`; // mock
  document.getElementById('lsIcon').style.color=m.color;
  document.getElementById('lsTitle').textContent=m.name;
  document.getElementById('lsDesc').textContent=m.desc;
  
  let list=document.getElementById('levelList'); list.innerHTML='';
  for(let i=0;i<5;i++){
    let st=ld[i], avail=i===0||ld[i-1].completed;
    let pool=QUESTIONS[cat].filter(q=>q.lvl===(i+1));
    let cls=st.completed?'completed':avail?'available':'locked';
    let icon=st.completed?'fa-check-circle':avail?'fa-play-circle':'fa-lock';
    let starsHtml=Array(3).fill(0).map((_,j)=>`<i class="fas fa-star ${j<st.stars?'lit':''}"></i>`).join('');
    
    let el=document.createElement('div'); el.className=`level-card ${cls}`;
    el.innerHTML=`
      <div class="lc-left"><div class="lc-num">${i+1}</div>
      <div class="lc-info"><h3>${LVL_NAMES[i]}</h3><p>${pool.length} Questions · ${i<2?'Easy':i===4?'Hard':'Medium'}</p></div></div>
      <div class="lc-right"><div class="lc-stars">${starsHtml}</div><div class="lc-status"><i class="fas ${icon}"></i></div></div>`;
    if(avail) el.onclick=()=>{ sfxK(); startLevel(cat, i+1); };
    list.appendChild(el);
  }
  showScreen('sLevelSelect');
}

// Quiz
function shuffle(a){let c=[...a];for(let i=c.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[c[i],c[j]]=[c[j],c[i]];}return c;}

function startLevel(cat, lvl){
  S.curCat=cat; S.curLevel=lvl; S.qIndex=0; S.quizScore=0; S.quizStreak=0; S.quizXP=0; S.lastQuizAnswers=[]; S.quizStarted=false;
  
  let pool=QUESTIONS[cat].filter(q=>q.lvl===lvl);
  S.qs=shuffle(pool); // use all questions for that level
  
  document.getElementById('quizCatName').textContent=`${CATEGORY_META[cat].name} — Level ${lvl}`;
  document.getElementById('quizCatDot').style.background=CATEGORY_META[cat].color;
  document.getElementById('quizTotal').textContent=S.qs.length;
  updateStats(); showScreen('sQuiz'); loadQ();
}

function loadQ(){
  if(S.qIndex>=S.qs.length){ finishLvl(); return; }
  S.questionAnswered=false; document.getElementById('explanationArea').innerHTML='';
  let q=S.qs[S.qIndex];
  document.getElementById('questionNumber').textContent=`Question ${S.qIndex+1} of ${S.qs.length}`;
  document.getElementById('questionText').textContent=q.q;
  document.getElementById('qProgressBar').style.width=`${(S.qIndex/S.qs.length)*100}%`;
  
  let list=document.getElementById('optionsList'); list.innerHTML='';
  // map options with original index
  let opts=q.opts.map((text,origIdx)=>({text, origIdx}));
  // opts=shuffle(opts); // optional shuffle
  let letters=['A','B','C','D'];
  opts.forEach((o,displayIdx)=>{
    let btn=document.createElement('button'); btn.className='option-btn';
    btn.innerHTML=`<span class="option-letter">${letters[displayIdx]}</span><span>${o.text}</span>`;
    btn.onclick=()=>pickA(displayIdx, o.origIdx);
    list.appendChild(btn);
  });
  
  if(S.qIndex>=1) S.quizStarted=true;
  startT(); S.quizStartTime=Date.now();
}

function startT(){
  clearInterval(S.timerInterval); let dur=TIMER_DUR[S.curLevel]*1000; S.timeLeft=dur;
  let f=document.getElementById('timerFill'); f.style.width='100%'; f.className='timer-fill';
  S.timerInterval=setInterval(()=>{
    S.timeLeft-=100; let pct=Math.max(0,(S.timeLeft/dur)*100);
    f.style.width=pct+'%'; f.className=pct<25?'timer-fill danger':pct<50?'timer-fill warning':'timer-fill';
    document.getElementById('quizTimerText').textContent=Math.ceil(S.timeLeft/1000)+'s';
    if(S.timeLeft<=0){ clearInterval(S.timerInterval); timeOut(); }
  },100);
}

function timeOut(){
  if(S.questionAnswered)return; S.questionAnswered=true; sfxT();
  let q=S.qs[S.qIndex]; S.quizStreak=0; S.totalAnswered++;
  S.lastQuizAnswers.push({q:q.q, opts:q.opts, correctIdx:q.a, selectedIdx:-1, isCor:false, expl:q.expl});
  let btns=document.querySelectorAll('.option-btn');
  btns.forEach((b,i)=>{ b.classList.add('disabled'); if(i===q.a) b.classList.add('correct'); }); // assumes no shuffle
  updateStats(); showExpl(q,false,"Time's up!"); setTimeout(()=>{S.qIndex++;loadQ();},2800);
}

function pickA(dIdx, oIdx){
  if(S.questionAnswered)return; S.questionAnswered=true; clearInterval(S.timerInterval);
  let q=S.qs[S.qIndex], isCor=oIdx===q.a, t=(Date.now()-S.quizStartTime)/1000;
  S.totalAnswered++;
  if(isCor){
    sfxC(); S.quizScore++; S.quizStreak++; S.totalCorrect++; S.bestStreak=Math.max(S.bestStreak,S.quizStreak);
    if(S.curLevel>=4) S.hardCorrect++;
    let xp=XP_MAP[S.curLevel];
    if(S.quizStreak>=5) xp=Math.round(xp*1.5); if(S.quizStreak>=10) xp=Math.round(xp*2);
    if(t<3){ xp=Math.round(xp*1.25); S.fastAnswer++; }
    S.quizXP+=xp; S.totalXP+=xp; flyXP(xp);
  } else { sfxW(); S.quizStreak=0; document.getElementById('optionsList').classList.add('shake-anim'); setTimeout(()=>document.getElementById('optionsList').classList.remove('shake-anim'),500); }
  
  S.lastQuizAnswers.push({q:q.q, opts:q.opts, correctIdx:q.a, selectedIdx:oIdx, isCor, expl:q.expl});
  
  let btns=document.querySelectorAll('.option-btn');
  // assuming no shuffle for simplicity of displayIdx == origIdx
  btns.forEach((b,i)=>{
    b.classList.add('disabled');
    if(i===q.a) b.classList.add('correct');
    else if(i===dIdx && !isCor) b.classList.add('incorrect');
  });
  
  updateStats(); showExpl(q,isCor); checkAch(); setTimeout(()=>{S.qIndex++;loadQ();},isCor?2200:3000);
}

function updateStats(){
  document.getElementById('quizXP').textContent=S.quizXP; document.getElementById('quizStreak').textContent=S.quizStreak;
  document.getElementById('quizScore').textContent=S.quizScore;
  document.getElementById('streakPill').classList.toggle('hot',S.quizStreak>=5);
}
function showExpl(q,isC,cLab){
  document.getElementById('explanationArea').innerHTML=`<div class="explanation-box"><div class="label"><i class="fas ${isC?'fa-check-circle':'fa-times-circle'}"></i> ${cLab||(isC?'Correct!':"Not quite — here's why:")}</div><div class="text">${q.expl}</div></div>`;
}
function flyXP(amt){
  let el=document.createElement('div'); el.className='xp-fly'; el.textContent='+'+amt+' XP';
  let r=document.getElementById('quizXP').getBoundingClientRect();
  el.style.left=r.left+'px'; el.style.top=(r.top-10)+'px'; document.body.appendChild(el); setTimeout(()=>el.remove(),1000);
}

document.getElementById('quizBackBtn').onclick=()=>{
  sfxK(); clearInterval(S.timerInterval);
  showCnf('Quit Quiz?','Progress in this level will be lost.',()=>{showScreen('sLevelSelect');});
};

function finishLvl(){
  clearInterval(S.timerInterval); S.totalQuizzes++;
  let tot=S.qs.length, cor=S.quizScore, pct=Math.round((cor/tot)*100);
  if(cor===tot) S.perfectQuizzes++;
  
  let ld=S.categoryData[S.curCat].levelData[S.curLevel-1];
  let passed = pct>=60;
  let st = pct===100?3:pct>=70?2:pct>=50?1:0;
  
  if(passed && !ld.completed){ ld.completed=true; S.levelsCleared++; if(S.curLevel===5) S.lvl5Cleared++; }
  if(st > ld.stars) ld.stars=st;
  if(st === 3) S.tripleStars++;
  
  // check realm master
  if(S.categoryData[S.curCat].levelData.filter(l=>l.completed).length === 5){
    // verify not already counted (rudimentary, simplified for now: just recalc total)
    S.realmsMastered = Object.values(S.categoryData).filter(c=>c.levelData.filter(l=>l.completed).length===5).length;
  }
  
  document.getElementById('resultsTitle').textContent=passed?'Level Cleared!':'Keep Trying';
  document.getElementById('resultsSubtitle').textContent=passed?`You mastered ${CATEGORY_META[S.curCat].name} Level ${S.curLevel}`:`You need 60% to pass`;
  document.getElementById('resultsIcon').innerHTML=`<i class="fas ${passed?'fa-trophy':'fa-book-open'}"></i>`;
  document.getElementById('scoreRingValue').textContent=pct+'%';
  document.getElementById('resXP').textContent=S.quizXP; document.getElementById('resCorrect').textContent=cor; document.getElementById('resWrong').textContent=tot-cor;
  
  let circ=document.getElementById('scoreCircle');
  circ.style.stroke=pct>=80?'#10b981':pct>=60?'#f59e0b':pct>=40?'#f97316':'#ef4444';
  circ.style.transition='none'; circ.style.strokeDashoffset=427.26;
  setTimeout(()=>{ circ.style.transition='stroke-dashoffset 1.2s cubic-bezier(.2,1,.3,1)'; circ.style.strokeDashoffset=427.26-(pct/100)*427.26; },200);

  let sEls=document.getElementById('resultsStars').querySelectorAll('.fas');
  sEls.forEach(e=>e.className='fas fa-star');
  sEls.forEach((e,i)=>{ if(i<st) setTimeout(()=>e.classList.add('lit'),400+i*200); });
  
  let ban=document.getElementById('levelCompleteBanner'), nxt=document.getElementById('nextLvlBtn');
  if(passed){
    ban.classList.add('show');
    document.getElementById('bannerText').textContent=`Level ${S.curLevel} Complete`+(S.curLevel<5?` — Level ${S.curLevel+1} Unlocked!`:'');
    nxt.style.display=S.curLevel<5?'inline-flex':'none';
    nxt.onclick=()=>{ sfxK(); startLevel(S.curCat, S.curLevel+1); };
  } else { ban.classList.remove('show'); nxt.style.display='none'; }

  showScreen('sResults'); checkAch();
}

document.getElementById('retryBtn').onclick=()=>{ sfxK(); startLevel(S.curCat, S.curLevel); };
document.getElementById('reviewBtn').onclick=()=>{
  sfxK(); let list=document.getElementById('reviewList'); list.innerHTML='';
  S.lastQuizAnswers.forEach((a,i)=>{
    let div=document.createElement('div'); div.className=`review-item ${a.isCor?'was-correct':'was-wrong'}`;
    let letters=['A','B','C','D'];
    let ansHtml=a.opts.map((o,j)=>`<span class="review-answer ${j===a.correctIdx?'correct-a':j===a.selectedIdx?'wrong-a':''}">${letters[j]}. ${o}</span>`).join('');
    div.innerHTML=`<div class="review-q">${i+1}. ${a.q}</div><div class="review-answers">${ansHtml}</div><div class="review-expl"><i class="fas fa-info-circle" style="color:var(--accent);margin-right:4px;"></i>${a.expl}</div>`;
    list.appendChild(div);
  });
  showScreen('sReview');
};
document.getElementById('reviewBackBtn').onclick=()=>{ sfxK(); showScreen('sResults'); };
document.getElementById('backHubBtn').onclick=()=>{ sfxK(); showScreen('sHub'); };

// Achievements
function checkAch(){
  ACHIEVEMENTS.forEach(a=>{
    if(!S.unlockedAchievements.has(a.id) && a.check(S)){
      S.unlockedAchievements.add(a.id); S.newAchievements.add(a.id); sfxA(); updateBadge();
      let t=document.createElement('div'); t.className='toast'; t.innerHTML=`<i class="fas ${a.icon}"></i><span>Achievement: ${a.name}</span>`;
      document.body.appendChild(t); setTimeout(()=>{t.style.opacity='0';t.style.transition='opacity .3s';setTimeout(()=>t.remove(),300);},3000);
    }
  });
}
function renderAchievements(){
  let grid=document.getElementById('achievementsGrid'); grid.innerHTML='';
  document.getElementById('achieveCount').textContent=`${S.unlockedAchievements.size} / 15 Unlocked`;
  ACHIEVEMENTS.forEach(a=>{
    let unl=S.unlockedAchievements.has(a.id), isNew=S.newAchievements.has(a.id);
    let el=document.createElement('div'); el.className=`achievement-card ${unl?'unlocked':'locked'} ${isNew?'new-unlock':''}`;
    el.innerHTML=`<div class="badge-new">NEW</div><div class="achievement-icon"><i class="fas ${a.icon}"></i></div><div class="achievement-name">${a.name}</div><div class="achievement-desc">${a.desc}</div>`;
    grid.appendChild(el);
  });
}

// Profile
function renderProfile(){
  let li=calcLevel();
  document.getElementById('profileName').textContent=S.playerName;
  document.getElementById('profileBigAvatar').textContent=S.playerName.charAt(0).toUpperCase();
  document.getElementById('profileLevel').textContent=`Level ${li.lvl} — ${getRank(li.lvl)}`;
  document.getElementById('profileXpCurrent').textContent=`${li.xpIn} XP`; document.getElementById('profileXpNeeded').textContent=`${li.xpNeed} XP`;
  document.getElementById('profileXpFill').style.width=`${li.pct}%`;
  
  let totStars = Object.values(S.categoryData).reduce((sum,c)=>sum+c.levelData.reduce((s,l)=>s+l.stars,0), 0);
  let acc=S.totalAnswered>0?Math.round((S.totalCorrect/S.totalAnswered)*100):0;
  
  document.getElementById('profileStatsGrid').innerHTML=`
    <div class="profile-stat-card"><div class="pval">${S.levelsCleared}/35</div><div class="plbl">Levels Cleared</div></div>
    <div class="profile-stat-card"><div class="pval">${totStars}</div><div class="plbl">Total Stars</div></div>
    <div class="profile-stat-card"><div class="pval">${S.totalXP}</div><div class="plbl">Total XP</div></div>
    <div class="profile-stat-card"><div class="pval">${S.unlockedAchievements.size}/15</div><div class="plbl">Achievements</div></div>
    <div class="profile-stat-card"><div class="pval">${S.totalQuizzes}</div><div class="plbl">Quizzes</div></div>
    <div class="profile-stat-card"><div class="pval">${S.totalAnswered}</div><div class="plbl">Questions</div></div>
    <div class="profile-stat-card"><div class="pval">${acc}%</div><div class="plbl">Accuracy</div></div>
    <div class="profile-stat-card"><div class="pval">${S.bestStreak}</div><div class="plbl">Best Streak</div></div>
    <div class="profile-stat-card"><div class="pval">${Object.values(S.categoryData).filter(c=>c.levelData[0].completed||c.levelData[0].stars>0).length}/7</div><div class="plbl">Realms Explored</div></div>
    <div class="profile-stat-card"><div class="pval">${S.realmsMastered}</div><div class="plbl">Realms Mastered</div></div>`;
}

// Edit / Reset / Confirm
let cb=null;
function showCnf(t,m,onC){ document.getElementById('confirmTitle').textContent=t; document.getElementById('confirmMsg').textContent=m; cb=onC; document.getElementById('confirmModal').classList.add('open'); }
document.getElementById('confirmCancelBtn').onclick=()=>{ sfxK(); document.getElementById('confirmModal').classList.remove('open'); cb=null; };
document.getElementById('confirmOkBtn').onclick=()=>{ sfxK(); document.getElementById('confirmModal').classList.remove('open'); if(cb)cb(); cb=null; };

document.getElementById('profileEditBtn').onclick=()=>{ sfxK(); document.getElementById('editNameInput').value=S.playerName; document.getElementById('nameModal').classList.add('open'); };
document.getElementById('nameCancelBtn').onclick=()=>{ sfxK(); document.getElementById('nameModal').classList.remove('open'); };
document.getElementById('nameSaveBtn').onclick=()=>{
  let n=document.getElementById('editNameInput').value.trim();
  if(n){ S.playerName=n; let init=n.charAt(0).toUpperCase(); document.getElementById('hubAvatar').textContent=init; document.getElementById('hubName').textContent=n; document.getElementById('profileBigAvatar').textContent=init; document.getElementById('profileName').textContent=n; sfxK(); }
  document.getElementById('nameModal').classList.remove('open');
};

document.getElementById('profileResetBtn').onclick=()=>{
  sfxK(); showCnf('Reset Progress?','All data will be erased permanently.',()=>{
    S.totalXP=0; S.curLevelNum=1; S.bestStreak=0; S.totalCorrect=0; S.totalAnswered=0; S.totalQuizzes=0; S.perfectQuizzes=0; S.hardCorrect=0; S.fastAnswer=0; S.levelsCleared=0; S.lvl5Cleared=0; S.tripleStars=0; S.realmsMastered=0;
    S.unlockedAchievements.clear(); S.newAchievements.clear(); S.lastQuizAnswers=[];
    Object.keys(S.categoryData).forEach(c=>{ S.categoryData[c].levelData.forEach(l=>{l.stars=0;l.completed=false;}); });
    renderProfile(); let t=document.createElement('div'); t.className='toast'; t.innerHTML=`<i class="fas fa-rotate-left"></i><span>Progress reset.</span>`; document.body.appendChild(t); setTimeout(()=>{t.style.opacity='0';setTimeout(()=>t.remove(),300);},3000);
  });
};

document.addEventListener('keydown',e=>{
  if(!document.getElementById('sQuiz').classList.contains('active')||S.questionAnswered)return;
  let k=parseInt(e.key); if(k>=1&&k<=4) pickA(k-1, S.qs[S.qIndex].opts.map((o,i)=>({o,i}))[k-1].i); // simple mapping
});
</script>
</body>
</html>